# Πρότυπο για τα Streamlit Secrets.
#
# Streamlit Community Cloud: share.streamlit.io -> η εφαρμογή -> ⋮ -> Settings -> Secrets
#   επικολλήστε ΟΛΟ αυτό το περιεχόμενο με τις πραγματικές τιμές.
# Τοπικά: αντιγράψτε σε .streamlit/secrets.toml (το αρχείο αγνοείται από το git).
#
# ΠΟΤΕ μην ανεβάσετε πραγματικούς κωδικούς/κλειδιά στο GitHub.

[database]
# Supabase -> Project -> Connect -> "Session pooler" (IPv4, θύρα 5432).
# Αντικαταστήστε [YOUR-PASSWORD] με τον κωδικό της βάσης. Κρατήστε το ?sslmode=require.
url = "postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

[supabase]
# Supabase -> Project Settings -> API (Data API)
url = "https://abcdefghijklmnop.supabase.co"
# Το "service_role" (ή νέο "secret") key. Χρησιμοποιείται ΜΟΝΟ από την Python στον server,
# ποτέ στον browser. Μην το μοιραστείτε.
service_key = "eyJhbGciOi...service_role..."
# Όνομα του PRIVATE bucket στο Supabase Storage
bucket = "warehouse-excel"

[auth]
# Τυχαίο κείμενο τουλάχιστον 32 χαρακτήρων (υπογραφή συνδέσεων). Π.χ. από:
#   python -c "import secrets; print(secrets.token_hex(32))"
secret_key = "αλλάξτε-με-τυχαίο-κείμενο-τουλάχιστον-32-χαρακτήρων"
admin_password = "αλλάξτε-με-ισχυρό-κωδικό"
secretary_password = "αλλάξτε-με-ισχυρό-κωδικό"
scanner_password = "αλλάξτε-με-ισχυρό-κωδικό"
# Πόσο διαρκεί το «Να με θυμάται αυτός ο υπολογιστής» (ώρες)
scanner_token_hours = 720
user_token_hours = 12

[app]
timezone = "Europe/Athens"
# Ακριβή ονόματα φύλλων (προεπιλογές: '΄Ετοιμα προϊόντα' και 'Σβησμενα ' με κενό στο τέλος).
# source_sheet = "΄Ετοιμα προϊόντα"
# target_sheet = "Σβησμενα "
