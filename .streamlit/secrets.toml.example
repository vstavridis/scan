# Πρότυπο για τα Streamlit Secrets.
#
# Streamlit Community Cloud: share.streamlit.io -> η εφαρμογή -> ⋮ -> Settings -> Secrets
#   επικολλήστε ΟΛΟ αυτό το περιεχόμενο με τις πραγματικές τιμές.
# Τοπικά: αντιγράψτε σε .streamlit/secrets.toml (το αρχείο αγνοείται από το git).
#
# ΠΟΤΕ μην ανεβάσετε πραγματικούς κωδικούς/κλειδιά στο GitHub.
#
# Απαιτούνται ΜΟΝΟ: [database] url και [supabase] url, service_key, bucket.
# Δεν υπάρχει εσωτερικό login: η πρόσβαση ελέγχεται από το Streamlit Cloud (Private app,
# μόνο προσκεκλημένοι χρήστες).

[database]
# Supabase -> Project -> Connect -> "Session pooler" (IPv4, θύρα 5432).
# Αντικαταστήστε [YOUR-PASSWORD] με τον κωδικό της βάσης. Κρατήστε το ?sslmode=require.
# Μορφή: postgresql://postgres.uwzqfxvyjjprrqaxuztx:[YOUR-PASSWORD]@aws-<N>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Αντιγράψτε το ΑΚΡΙΒΕΣ host από το Supabase (Connect -> Session pooler). Ειδικοί χαρακτήρες
# στον κωδικό γράφονται URL-encoded (π.χ. @ -> %40, # -> %23, / -> %2F).
url = "postgresql://postgres.uwzqfxvyjjprrqaxuztx:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

[supabase]
# Project URL (δεν είναι μυστικό)
url = "https://uwzqfxvyjjprrqaxuztx.supabase.co"
# Supabase -> Project Settings -> API Keys -> Secret keys (sb_secret_...).
# Υποστηρίζεται και το παλαιό "service_role" JWT. ΠΟΤΕ το publishable/anon key.
# Χρησιμοποιείται ΜΟΝΟ από την Python στον server, ποτέ στον browser.
service_key = "sb_secret_[ΒΑΛΤΕ-ΕΔΩ-ΤΟ-SECRET-KEY]"
# Όνομα του PRIVATE bucket στο Supabase Storage
bucket = "warehouse-excel"

# Προαιρετικά:
[app]
timezone = "Europe/Athens"
# Ακριβή ονόματα φύλλων (προεπιλογές: '΄Ετοιμα προϊόντα' και 'Σβησμενα ' με κενό στο τέλος).
# source_sheet = "΄Ετοιμα προϊόντα"
# target_sheet = "Σβησμενα "
