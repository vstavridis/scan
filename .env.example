# Αντιγράψτε αυτό το αρχείο σε ".env" και συμπληρώστε τις τιμές.
# Το .env ΔΕΝ ανεβαίνει στο GitHub (βλ. .gitignore).

# Κωδικοί ανά ρόλο
APP_ADMIN_PASSWORD=αλλάξτε-με-ισχυρό-κωδικό
APP_SECRETARY_PASSWORD=αλλάξτε-με-ισχυρό-κωδικό
APP_SCANNER_PASSWORD=αλλάξτε-με-ισχυρό-κωδικό

# Μυστικό κλειδί υπογραφής συνδέσεων (τυχαίο κείμενο ≥32 χαρακτήρες).
# Αν μείνει κενό, δημιουργείται αυτόματα στο data/secret.key
APP_SECRET_KEY=

# Φάκελος μόνιμων δεδομένων (βάση, Excel, backups, logs)
APP_DATA_DIR=data

# Θύρες
APP_API_PORT=8000
APP_UI_PORT=8501
# 0.0.0.0 = προσβάσιμο από το τοπικό δίκτυο (LAN)
APP_API_HOST=0.0.0.0

# Διάρκεια σύνδεσης (ώρες)
APP_SCANNER_TOKEN_HOURS=720
APP_USER_TOKEN_HOURS=12

APP_TIMEZONE=Europe/Athens
APP_LOG_LEVEL=INFO

# Ακριβή ονόματα φύλλων (προεπιλογή: '΄Ετοιμα προϊόντα' και 'Σβησμενα ' με κενό στο τέλος).
# Αλλάξτε τα μόνο αν αλλάξει το workbook.
# APP_SOURCE_SHEET=΄Ετοιμα προϊόντα
# APP_TARGET_SHEET="Σβησμενα "
